<%
    String mode = (String) request.getAttribute("shopHeaderMode");
    String contextPath = request.getContextPath();
    Object cartCountObj = request.getAttribute("cartCount");
    String cartCount = cartCountObj == null ? "0" : String.valueOf(cartCountObj);
    boolean isHome = "home".equals(mode);
    boolean isDetail = "detail".equals(mode);
    boolean isCart = "cart".equals(mode);
    boolean isCheckout = "checkout".equals(mode);
    boolean isMyOrders = "my-orders".equals(mode);
    boolean isLookup = "lookup".equals(mode);
    boolean isOrderDetail = "order-detail".equals(mode);
%>
<header class="shop-topbar">
    <nav class="max-w-screen-2xl mx-auto px-6 md:px-8 py-5 flex items-center justify-between gap-6">
        <a href="<%= contextPath %>/shop" class="brand text-3xl font-extrabold tracking-tight">Bookora</a>

        <div class="hidden md:flex items-center gap-8">
            <a href="<%= contextPath %>/shop" class="shop-nav-link <%= (isHome || isDetail) ? "active" : "" %>">Shop</a>
            <a href="<%= contextPath %>/shop/cart" class="shop-nav-link <%= (isCart || isCheckout) ? "active" : "" %>">Cart</a>
            <a href="<%= contextPath %>/shop/my-orders" class="shop-nav-link <%= isMyOrders ? "active" : "" %>">My Orders</a>
            <a href="<%= contextPath %>/shop/order-lookup" class="shop-nav-link <%= (isLookup || isOrderDetail) ? "active" : "" %>">Order Lookup</a>
        </div>

        <div class="flex items-center gap-3 md:gap-4">
            <a href="<%= contextPath %>/shop/cart" class="relative px-3 py-2 shop-chip text-sm font-semibold text-[var(--primary)]">
                Cart
                <span class="absolute -top-2 -right-2 bg-[var(--secondary)] text-white text-[10px] font-bold w-5 h-5 rounded-full flex items-center justify-center"><%= cartCount %></span>
            </a>
            <% if (isHome) { %>
                <a href="<%= contextPath %>/" class="px-3 py-2 shop-chip text-sm font-semibold text-[var(--primary)]">Quan tri</a>
            <% } %>
        </div>
    </div>
    </nav>
</header>
